<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <RootNamespace>Aski.NativeClient</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="OpenCvSharp4" Version="4.10.0.20240616" />
    <PackageReference Include="OpenCvSharp4.runtime.win" Version="4.10.0.20240616" />
    <PackageReference Include="SocketIOClient" Version="4.0.1" />
    <PackageReference Include="System.Security.Cryptography.ProtectedData" Version="8.0.0" />
  </ItemGroup>

  <ItemGroup>
    <Compile Remove="Aski.NativeClient.Host\\**\\*.cs" />
    <Compile Remove="Aski.NativeClient.ConnectionCheck\\**\\*.cs" />
    <None Remove="Aski.NativeClient.Host\\**\\*" />
    <None Remove="Aski.NativeClient.ConnectionCheck\\**\\*" />
  </ItemGroup>
</Project>
